Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /gazebo_11
        - /gazebo_21
      Splitter Ratio: 0.5
    Tree Height: 620
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 100; 100; 100
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.7
          Class: rviz_default_plugins/Map
          Color Scheme: map
          Enabled: true
          Name: Map
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /gazebo_1/map
          Use Timestamp: false
          Value: true
        - Class: rviz_default_plugins/PoseWithCovariance
          Enabled: true
          Name: Pose
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /gazebo_1/amcl_pose
          Value: true
        - Alpha: 0.45
          Class: rviz_default_plugins/Map
          Color Scheme: costmap
          Enabled: true
          Name: Global Costmap
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /gazebo_1/global_costmap/costmap
          Use Timestamp: false
          Value: true
        - Alpha: 0.45
          Class: rviz_default_plugins/Map
          Color Scheme: costmap
          Enabled: false
          Name: Local Costmap
          Topic:
            Depth: 1
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /gazebo_1/local_costmap/costmap
          Use Timestamp: false
          Value: false
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 0; 180; 255
          Enabled: true
          Head Diameter: 0.15
          Head Length: 0.1
          Length: 0.3
          Line Style: Lines
          Line Width: 0.05
          Name: Global Path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 0; 180; 255
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0.03
          Shaft Length: 0.1
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /gazebo_1/plan
          Value: true
        - Class: rviz_default_plugins/LaserScan
          Color: 0; 180; 255
          Decay Time: 0
          Enabled: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: LaserScan
          Size (m): 0.05
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /gazebo_1/scan
          Use Fixed Frame: true
          Value: false
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: Route Graph
          Namespaces:
            "": true
          Topic:
            Depth: 5
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /gazebo_1/route_graph/markers
          Value: true
      Enabled: true
      Name: gazebo_1
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.7
          Class: rviz_default_plugins/Map
          Color Scheme: map
          Enabled: false
          Name: Map
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /gazebo_2/map
          Use Timestamp: false
          Value: false
        - Class: rviz_default_plugins/PoseWithCovariance
          Enabled: true
          Name: Pose
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /gazebo_2/amcl_pose
          Value: true
        - Alpha: 0.45
          Class: rviz_default_plugins/Map
          Color Scheme: costmap
          Enabled: true
          Name: Global Costmap
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /gazebo_2/global_costmap/costmap
          Use Timestamp: false
          Value: true
        - Alpha: 0.45
          Class: rviz_default_plugins/Map
          Color Scheme: costmap
          Enabled: false
          Name: Local Costmap
          Topic:
            Depth: 1
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /gazebo_2/local_costmap/costmap
          Use Timestamp: false
          Value: false
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 115; 0
          Enabled: true
          Head Diameter: 0.15
          Head Length: 0.1
          Length: 0.3
          Line Style: Lines
          Line Width: 0.05
          Name: Global Path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 115; 0
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0.03
          Shaft Length: 0.1
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /gazebo_2/plan
          Value: true
        - Class: rviz_default_plugins/LaserScan
          Color: 255; 115; 0
          Decay Time: 0
          Enabled: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: LaserScan
          Size (m): 0.05
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /gazebo_2/scan
          Use Fixed Frame: true
          Value: false
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: Route Graph
          Namespaces:
            "": true
          Topic:
            Depth: 5
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /gazebo_2/route_graph/markers
          Value: true
      Enabled: true
      Name: gazebo_2
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: false
      Marker Scale: 1.0
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Tree:
        {}
      Update Interval: 0
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /gazebo_1/initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /gazebo_1/goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 50
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1400
  X: 80
  Y: 60
